# Copy this file to .env and fill only the settings required by your COPT setup.
# The real .env file is ignored by Git. Existing process environment variables
# take precedence over values loaded from this file.

# Optional exact COPT native library. Leave empty to use COPT_HOME discovery.
COPT_DLL_PATH=

# General COPT environment configuration.
COPT_ENV_NO_BANNER=1

# OEM configuration. Never commit real values.
COPT_OEM_NAME=
COPT_OEM_SIGNATURE=

# Optional COPT client configuration. Empty values are ignored.
COPT_CLIENT_CAFILE=
COPT_CLIENT_CERTFILE=
COPT_CLIENT_CERTKEYFILE=
COPT_CLIENT_CLUSTER=
COPT_CLIENT_FLOATING=
COPT_CLIENT_PASSWORD=
COPT_CLIENT_PORT=
COPT_CLIENT_PRIORITY=
COPT_CLIENT_WAITTIME=
COPT_CLIENT_WEBSERVER=
COPT_CLIENT_WEBLICENSEID=
COPT_CLIENT_WEBACCESSKEY=
COPT_CLIENT_WEBTOKENDURATION=
